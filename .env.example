# C++ High-Performance Cloud Application Configuration
# Copy this file to .env and fill in your local or AWS RDS/S3 parameters

PORT=8080
SECRET_KEY=super-secret-cpp-cloud-key-2026

# MySQL / Amazon RDS Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=student_management_db

# AWS Cloud Services Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=student-system-reports-bucket-demo
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:low-attendance-alerts
